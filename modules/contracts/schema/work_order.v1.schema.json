{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsx.work_order.v1",
  "title": "BSX work order (Void Salvage to BSX)",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "contract_id",
    "issued_at",
    "client",
    "ship",
    "changes",
    "manifest"
  ],
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "bsx.work_order"
    },
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "client": {
      "type": "object",
      "required": [
        "company"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "game": {
          "enum": [
            "void_salvage",
            "bsx_generated"
          ]
        }
      }
    },
    "ship": {
      "type": "object",
      "required": [
        "ship_id",
        "design"
      ],
      "properties": {
        "ship_id": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "current_fit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "component"
            ],
            "properties": {
              "slot": {
                "type": "string"
              },
              "component": {
                "$ref": "#/$defs/component"
              },
              "condition": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "action",
          "slot"
        ],
        "properties": {
          "change_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "add",
              "remove",
              "replace"
            ]
          },
          "slot": {
            "type": "string"
          },
          "remove": {
            "$ref": "#/$defs/component"
          },
          "install": {
            "$ref": "#/$defs/component"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "add"
                }
              }
            },
            "then": {
              "required": [
                "install"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "remove"
                }
              }
            },
            "then": {
              "required": [
                "remove"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "replace"
                }
              }
            },
            "then": {
              "required": [
                "install",
                "remove"
              ]
            }
          }
        ]
      }
    },
    "manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "component"
        ],
        "properties": {
          "line_id": {
            "type": "string"
          },
          "component": {
            "$ref": "#/$defs/component"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "supplied_by": {
            "enum": [
              "client",
              "bsx"
            ]
          },
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "new",
                "refurbished",
                "salvaged"
              ]
            }
          }
        }
      }
    },
    "spec_sheet": {
      "type": "object",
      "properties": {
        "library": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "change_id"
            ],
            "properties": {
              "change_id": {
                "type": "string"
              },
              "bolt": {
                "type": "object"
              },
              "rivet": {
                "type": "object"
              },
              "weld": {
                "type": "object"
              },
              "connector": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "change_id": {
            "type": "string"
          },
          "attachment": {
            "type": "string"
          }
        }
      }
    },
    "commercial": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "deposit_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "late_penalty_per_day": {
          "type": "number"
        },
        "due_day": {
          "type": "integer",
          "minimum": 0,
          "description": "BSX game day the job is due, used by Business until Core has a calendar"
        }
      }
    }
  }
}