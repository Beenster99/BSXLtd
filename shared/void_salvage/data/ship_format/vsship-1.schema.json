{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/dantheo999/void-salvage/data/ship_format/vsship-1.schema.json",
	"title": "vsship 1.x: a Void Salvage ship file",
	"description": "The prose is docs/SHIP_FORMAT_PLAN.md. Readers ignore keys they do not know and keep them when they write the file back, so no object here forbids extra keys. Units: metres, kilograms, seconds, newtons, radians.",
	"type": "object",
	"required": ["format", "version", "generator", "ship", "stats", "materials", "hulls", "walls", "fittings", "systems", "pieces", "lights", "slots", "layout", "modules", "derived"],
	"properties": {
		"format": {"const": "vsship"},
		"version": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
		"generator": {
			"type": "object",
			"required": ["app", "version"],
			"properties": {"app": {"type": "string"}, "version": {"type": "string"}, "date": {"type": "string"}}
		},
		"ship": {
			"type": "object",
			"required": ["id", "name", "class", "base", "livery", "serial"],
			"properties": {
				"id": {"type": "string"},
				"name": {"type": "string"},
				"class": {"enum": ["S", "M", "L", "XL"]},
				"base": {"type": "object", "required": ["design"], "properties": {"design": {"type": "string"}, "app_version": {"type": "string"}}},
				"livery": {"type": "string"},
				"serial": {"type": "string", "pattern": "^VS-[A-Z0-9]+-[0-9]+$"},
				"owner": {"type": "string"}
			}
		},
		"stats": {"type": "object", "additionalProperties": {"anyOf": [{"type": "number"}, {"type": "boolean"}, {"$ref": "#/$defs/vec2"}, {"$ref": "#/$defs/vec3"}]}},
		"materials": {"type": "object", "additionalProperties": {"$ref": "#/$defs/material"}},
		"hulls": {"type": "array", "items": {"$ref": "#/$defs/hull"}},
		"walls": {"type": "array", "items": {"$ref": "#/$defs/wall"}},
		"fittings": {"type": "array", "items": {"$ref": "#/$defs/fitting"}},
		"systems": {"type": "array", "items": {"$ref": "#/$defs/system"}},
		"pieces": {"type": "array", "items": {"$ref": "#/$defs/piece"}},
		"lights": {"type": "array", "items": {"$ref": "#/$defs/light"}},
		"slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
		"layout": {"$ref": "#/$defs/layout"},
		"modules": {"type": "object", "additionalProperties": {"type": "boolean"}},
		"derived": {
			"type": "object",
			"required": ["volume_m3", "meshes", "shapes", "lights", "pieces", "fittings", "systems", "recipe_less", "bounds", "body_hash"],
			"properties": {
				"volume_m3": {"type": "number", "minimum": 0},
				"meshes": {"type": "integer", "minimum": 0},
				"shapes": {"type": "integer", "minimum": 0},
				"lights": {"type": "integer", "minimum": 0},
				"pieces": {"type": "integer", "minimum": 0},
				"fittings": {"type": "integer", "minimum": 0},
				"systems": {"type": "integer", "minimum": 0},
				"recipe_less": {"type": "integer", "minimum": 0},
				"hold_m3": {"type": "number", "minimum": 0},
				"bounds": {"$ref": "#/$defs/aabb"},
				"body_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
			}
		},
		"order": {
			"type": "object",
			"properties": {
				"contract_id": {"type": "string"},
				"workshop": {"type": "string"},
				"against": {"type": "string"},
				"issued": {"type": "string"},
				"items": {"type": "array", "items": {"type": "object", "required": ["change_id", "slot"], "properties": {
					"change_id": {"type": "string"}, "slot": {"type": "string"}, "component": {"type": ["string", "null"]},
					"quality": {"type": "number", "minimum": 0, "maximum": 1}, "price": {"type": "number"}}}},
				"total": {"type": "number"}
			}
		}
	},
	"$defs": {
		"vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
		"vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
		"rect": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h]"},
		"color": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 4},
		"aabb": {"type": "object", "required": ["pos", "size"], "properties": {"pos": {"$ref": "#/$defs/vec3"}, "size": {"$ref": "#/$defs/vec3"}}},
		"xform": {
			"type": "object",
			"required": ["o"],
			"description": "origin, and the basis as its rows (omitted = identity)",
			"properties": {"o": {"$ref": "#/$defs/vec3"}, "b": {"type": "array", "items": {"type": "number"}, "minItems": 9, "maxItems": 9}}
		},
		"outline": {"type": "array", "items": {"$ref": "#/$defs/vec2"}},
		"group": {"type": "string"},
		"mat": {"type": "string", "description": "a key of the file's materials"},
		"shape": {
			"type": "object",
			"required": ["shape", "args"],
			"description": "a PartShapes or FrameParts constructor by name, and its arguments in order",
			"properties": {
				"shape": {"enum": ["box", "wedge", "ridge", "slope", "trapezoid", "corner", "corner_cut", "prism", "frustum", "girder", "i_beam", "truss", "arc_panel", "dome", "chamfer_box", "ring", "nozzle", "louvre", "inset_panel", "porthole_round", "porthole_hex", "window_rect", "window_panel", "window_slit", "window_tri", "canopy_panel", "girder_corner", "node", "plate", "square", "rect", "tri_equilateral", "tri_isosceles", "tri_right", "tri_scalene", "plate_trapezoid", "parallelogram", "rhombus", "polygon", "chamfered_rect"]},
				"args": {"type": "array"}
			}
		},
		"material": {
			"type": "object",
			"anyOf": [
				{"required": ["livery"], "properties": {"livery": {"enum": ["shell", "trim", "dark", "soft", "top", "belly", "lining", "steel", "edge", "screen", "warm", "cold"]}}},
				{"required": ["paint"], "properties": {"paint": {"$ref": "#/$defs/color"}, "metallic": {"type": "number"}, "roughness": {"type": "number"}, "finish": {"type": "string"}}},
				{"required": ["glow", "energy"], "properties": {"glow": {"$ref": "#/$defs/color"}, "energy": {"type": "number", "minimum": 0}}},
				{"required": ["glass"], "properties": {"glass": {"type": "string"}, "color": {"$ref": "#/$defs/color"}, "metallic": {"type": "number"}, "roughness": {"type": "number"}}}
			]
		},
		"look": {
			"anyOf": [
				{"const": "skip"},
				{"type": "object", "required": ["mat"], "properties": {"mat": {"$ref": "#/$defs/mat"}, "tag": {"type": "string"}, "solid": {"type": "boolean"}}}
			]
		},
		"hull": {
			"type": "object",
			"required": ["group", "skin", "frame_width", "frame_height", "node_size", "frames", "skin_mat", "frame_mat", "stations", "faces", "frame_skip", "caps"],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"skin": {"type": "number", "minimum": 0},
				"frame_width": {"type": "number", "minimum": 0},
				"frame_height": {"type": "number", "minimum": 0},
				"node_size": {"type": "number", "minimum": 0},
				"frames": {"type": "boolean"},
				"skin_mat": {"$ref": "#/$defs/mat"},
				"frame_mat": {"$ref": "#/$defs/mat"},
				"stations": {"type": "array", "items": {"type": "object", "required": ["z", "profile"], "properties": {
					"z": {"type": "number"}, "profile": {"anyOf": [{"const": "same"}, {"$ref": "#/$defs/outline"}]}}}},
				"faces": {"type": "object", "required": ["default"], "additionalProperties": {"$ref": "#/$defs/look"}},
				"frame_skip": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}},
				"caps": {"type": "array", "items": {"type": "object", "required": ["z", "facing", "mat", "pieces"], "properties": {
					"z": {"type": "number"}, "facing": {"type": "number"}, "mat": {"$ref": "#/$defs/mat"}, "tag": {"type": "string"},
					"pieces": {"type": "array", "items": {"$ref": "#/$defs/outline"}}}}},
				"box": {"$ref": "#/$defs/aabb"},
				"tags": {"type": "array", "items": {"type": "string"}}
			}
		},
		"wall": {
			"type": "object",
			"required": ["group", "mat"],
			"anyOf": [
				{"required": ["wall", "at", "u", "v", "thickness", "holes"]},
				{"required": ["block"]}
			],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"wall": {"enum": ["x", "y", "z"]},
				"at": {"type": "number"},
				"u": {"$ref": "#/$defs/vec2"},
				"v": {"$ref": "#/$defs/vec2"},
				"thickness": {"type": "number", "minimum": 0},
				"holes": {"type": "array", "items": {"$ref": "#/$defs/rect"}},
				"block": {"type": "object", "required": ["a", "b"], "properties": {"a": {"$ref": "#/$defs/vec3"}, "b": {"$ref": "#/$defs/vec3"}}},
				"mat": {"$ref": "#/$defs/mat"},
				"tag": {"type": "string"},
				"box": {"$ref": "#/$defs/aabb"},
				"tags": {"type": "array", "items": {"type": "string"}}
			}
		},
		"fitting": {
			"type": "object",
			"required": ["group", "fitting", "args", "box"],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"fitting": {"enum": ["seat", "console", "bunks", "locker", "galley", "table", "bench", "suit_stand", "trophy_shelf", "breaker_panel", "reactor_cabinet", "wall_rack", "hold_net", "lamp", "name_board", "armchair", "jump_seat", "railing", "stair_flight", "workbench", "reactor_core"]},
				"frame": {"$ref": "#/$defs/xform"},
				"args": {"type": "array"},
				"box": {"$ref": "#/$defs/aabb"},
				"label": {"type": "string"},
				"tags": {"type": "array", "items": {"type": "string"}}
			}
		},
		"system": {
			"type": "object",
			"required": ["group", "system", "box"],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"system": {"enum": ["control_panel", "lift", "bowsers", "fuel_port", "hose_rack", "monitor", "cockpit_monitor", "double_door", "door_panel", "cockpit_screen", "nav_display", "map_screen"]},
				"key": {"type": "string"},
				"frame": {"$ref": "#/$defs/xform"},
				"args": {"type": "array"},
				"box": {"$ref": "#/$defs/aabb"},
				"tags": {"type": "array", "items": {"type": "string"}}
			}
		},
		"piece": {
			"type": "object",
			"required": ["group", "shape", "xform"],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"shape": {"$ref": "#/$defs/shape"},
				"xform": {"$ref": "#/$defs/xform"},
				"mat": {"type": ["string", "null"]},
				"tag": {"type": "string"},
				"solid": {"type": "boolean"},
				"visual": {"type": "boolean", "description": "false: collision only (a ramp under steps)"},
				"glass_mat": {"$ref": "#/$defs/mat"}
			}
		},
		"light": {
			"type": "object",
			"required": ["group", "at", "color", "energy", "range"],
			"properties": {
				"group": {"$ref": "#/$defs/group"},
				"at": {"$ref": "#/$defs/vec3"},
				"color": {"$ref": "#/$defs/color"},
				"energy": {"type": "number", "minimum": 0},
				"range": {"type": "number", "minimum": 0},
				"shadows": {"type": "boolean"}
			}
		},
		"slot": {
			"type": "object",
			"required": ["slot_id", "display_name", "class", "accepts", "fitted", "mount", "box", "access", "group"],
			"properties": {
				"slot_id": {"type": "string"},
				"display_name": {"type": "string"},
				"class": {"enum": ["engine", "module"]},
				"accepts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
				"fitted": {"type": ["string", "null"]},
				"mount": {"$ref": "#/$defs/xform"},
				"box": {"$ref": "#/$defs/aabb"},
				"access": {"type": "string"},
				"group": {"$ref": "#/$defs/group"},
				"fasteners": {"type": "array", "items": {"type": "object", "required": ["id", "kind"], "properties": {
					"id": {"type": "string"}, "kind": {"type": "string"}, "spec": {"type": "string"},
					"at": {"$ref": "#/$defs/vec3"}, "normal": {"$ref": "#/$defs/vec3"}}}}
			}
		},
		"layout": {
			"type": "object",
			"required": ["rooms", "hold", "intakes", "seats", "exit_point", "doors", "usable_tags"],
			"properties": {
				"rooms": {"type": "array", "items": {"$ref": "#/$defs/aabb"}},
				"hold": {"$ref": "#/$defs/aabb"},
				"salvage_bay": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/aabb"}]},
				"cargo_bay": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/aabb"}]},
				"cabin_door": {"type": "string"},
				"hatch_area": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rect"}]},
				"intakes": {"type": "array", "items": {"type": "object", "required": ["key", "mouth", "out", "radius"], "properties": {
					"key": {"type": "string"}, "mouth": {"$ref": "#/$defs/vec3"}, "out": {"$ref": "#/$defs/vec3"},
					"radius": {"type": "number"}, "mouth_radius": {"type": "number"}, "glow": {"type": "string"}}}},
				"seats": {"type": "array", "items": {"type": "object", "required": ["at"], "properties": {
					"at": {"$ref": "#/$defs/vec3"}, "yaw": {"type": "number"}, "exit": {"$ref": "#/$defs/vec3"}}}},
				"exit_point": {"$ref": "#/$defs/vec3"},
				"lift_rect": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rect"}]},
				"doors": {"type": "object", "additionalProperties": {"type": "object", "required": ["travel"], "properties": {
					"travel": {"type": "number", "minimum": 0},
					"moves": {"type": "object", "additionalProperties": {"$ref": "#/$defs/vec3"}},
					"hinges": {"type": "object", "additionalProperties": {"type": "object", "required": ["at", "axis", "open"], "properties": {
						"at": {"$ref": "#/$defs/vec3"}, "axis": {"$ref": "#/$defs/vec3"}, "open": {"type": "number"}}}}}}},
				"panel_buttons": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3}},
				"usable_tags": {"type": "object", "additionalProperties": {"type": "string"}},
				"motor_at": {"type": "object", "additionalProperties": {"$ref": "#/$defs/vec3"}},
				"engine_at": {"$ref": "#/$defs/vec3"},
				"chase": {"type": "object", "properties": {"focus": {"$ref": "#/$defs/vec3"}, "distance": {"type": "number"}}},
				"floodlights": {"type": "array", "items": {"type": "object", "required": ["at", "aim"], "properties": {
					"at": {"$ref": "#/$defs/vec3"}, "aim": {"$ref": "#/$defs/vec3"}}}},
				"hatch_beacons": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
				"survey_glass": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
				"test_points": {"type": "object"}
			}
		}
	}
}
