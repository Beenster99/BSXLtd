{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/dantheo999/void-salvage/data/ship_format/vsship-2.schema.json",
	"title": "vsship 2.x: a Void Salvage ship built as parts and joints",
	"description": "The prose is docs/SHIP_FORMAT_PLAN.md section 10. A frame build: its builders' recipes (frame, decks, walls, services), the records 1.0 has (fittings, systems, pieces, lights, slots, layout), and the parts and joints the builders made (derived: every part and joint named by its path, each joint with its build phase, in the builder's order). Readers ignore keys they do not know and keep them when they write the file back. Units: metres, kilograms, seconds, newtons, radians. A number that would be infinite (no limit) is null.",
	"type": "object",
	"required": [
		"format",
		"version",
		"generator",
		"ship",
		"stats",
		"materials",
		"frame",
		"decks",
		"walls",
		"services",
		"fittings",
		"systems",
		"pieces",
		"units",
		"lights",
		"slots",
		"layout",
		"modules",
		"parts",
		"joints",
		"derived"
	],
	"properties": {
		"format": {
			"const": "vsship"
		},
		"version": {
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": 0
			},
			"minItems": 2,
			"maxItems": 2,
			"description": "[2, minor]"
		},
		"generator": {
			"type": "object",
			"required": [
				"app",
				"version"
			],
			"properties": {
				"app": {
					"type": "string"
				},
				"version": {
					"type": "string"
				},
				"date": {
					"type": "string"
				}
			}
		},
		"ship": {
			"type": "object",
			"required": [
				"id",
				"name",
				"class",
				"base",
				"livery",
				"serial"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"class": {
					"enum": [
						"S",
						"M",
						"L",
						"XL"
					]
				},
				"base": {
					"type": "object",
					"required": [
						"design"
					],
					"properties": {
						"design": {
							"type": "string"
						},
						"app_version": {
							"type": "string"
						}
					}
				},
				"livery": {
					"type": "string"
				},
				"serial": {
					"type": "string",
					"pattern": "^VS-[A-Z0-9]+-[0-9]+$"
				},
				"owner": {
					"type": "string"
				}
			}
		},
		"stats": {
			"type": "object",
			"additionalProperties": {
				"anyOf": [
					{
						"type": "number"
					},
					{
						"type": "boolean"
					},
					{
						"$ref": "#/$defs/vec2"
					},
					{
						"$ref": "#/$defs/vec3"
					}
				]
			}
		},
		"materials": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/material"
			}
		},
		"frame": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/frame_hull"
			},
			"description": "the hull sections (FrameHull runs), in the order they were built"
		},
		"decks": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/deck"
			},
			"description": "the decks (DeckFrame runs)"
		},
		"walls": {
			"type": "array",
			"items": {
				"anyOf": [
					{
						"$ref": "#/$defs/stud_wall"
					},
					{
						"$ref": "#/$defs/wall"
					}
				]
			}
		},
		"services": {
			"$ref": "#/$defs/services"
		},
		"fittings": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/fitting"
			}
		},
		"systems": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/system"
			}
		},
		"pieces": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/piece"
			}
		},
		"units": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/unit"
			},
			"description": "units opened outside a fitting's or system's record (a door's leaf, an engine): the pieces carrying its path fold into one part"
		},
		"lights": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/light"
			}
		},
		"slots": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/slot"
			}
		},
		"layout": {
			"$ref": "#/$defs/layout"
		},
		"modules": {
			"type": "object",
			"additionalProperties": {
				"type": "boolean"
			}
		},
		"parts": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/part"
			},
			"description": "derived: every part the build made, in the order it made them"
		},
		"joints": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/joint"
			},
			"description": "derived: every joint, in the builder's order"
		},
		"derived": {
			"type": "object",
			"required": [
				"volume_m3",
				"meshes",
				"shapes",
				"lights",
				"pieces",
				"fittings",
				"systems",
				"recipe_less",
				"bounds",
				"body_hash",
				"parts",
				"joints",
				"joints_by_phase",
				"joints_by_kind",
				"parts_hash"
			],
			"properties": {
				"volume_m3": {
					"type": "number",
					"minimum": 0
				},
				"meshes": {
					"type": "integer",
					"minimum": 0
				},
				"shapes": {
					"type": "integer",
					"minimum": 0
				},
				"lights": {
					"type": "integer",
					"minimum": 0
				},
				"pieces": {
					"type": "integer",
					"minimum": 0
				},
				"fittings": {
					"type": "integer",
					"minimum": 0
				},
				"systems": {
					"type": "integer",
					"minimum": 0
				},
				"recipe_less": {
					"type": "integer",
					"minimum": 0
				},
				"hold_m3": {
					"type": "number",
					"minimum": 0
				},
				"bounds": {
					"$ref": "#/$defs/aabb"
				},
				"body_hash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$",
					"description": "canonical JSON of [frame, decks, walls, services, fittings, systems, pieces, units, slots]"
				},
				"parts": {
					"type": "integer",
					"minimum": 0
				},
				"joints": {
					"type": "integer",
					"minimum": 0
				},
				"joints_by_phase": {
					"type": "object",
					"additionalProperties": {
						"type": "integer",
						"minimum": 0
					}
				},
				"joints_by_kind": {
					"type": "object",
					"additionalProperties": {
						"type": "integer",
						"minimum": 0
					}
				},
				"routes": {
					"type": "object",
					"description": "the routes the router laid: \"lead:<device path>\" and \"pipe:<run>\" -> points",
					"additionalProperties": {
						"type": "array",
						"items": {
							"$ref": "#/$defs/vec3"
						}
					}
				},
				"parts_hash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$",
					"description": "canonical JSON of [parts, joints]"
				}
			}
		},
		"order": {
			"type": "object",
			"properties": {
				"contract_id": {
					"type": "string"
				},
				"workshop": {
					"type": "string"
				},
				"against": {
					"type": "string"
				},
				"issued": {
					"type": "string"
				},
				"items": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"change_id",
							"slot"
						],
						"properties": {
							"change_id": {
								"type": "string"
							},
							"slot": {
								"type": "string"
							},
							"component": {
								"type": [
									"string",
									"null"
								]
							},
							"quality": {
								"type": "number",
								"minimum": 0,
								"maximum": 1
							},
							"price": {
								"type": "number"
							}
						}
					}
				},
				"total": {
					"type": "number"
				}
			}
		}
	},
	"$defs": {
		"vec2": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"minItems": 2,
			"maxItems": 2
		},
		"vec3": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"minItems": 3,
			"maxItems": 3
		},
		"rect": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"minItems": 4,
			"maxItems": 4,
			"description": "[x, y, w, h]"
		},
		"color": {
			"type": "array",
			"items": {
				"type": "number",
				"minimum": 0
			},
			"minItems": 3,
			"maxItems": 4
		},
		"aabb": {
			"type": "object",
			"required": [
				"pos",
				"size"
			],
			"properties": {
				"pos": {
					"$ref": "#/$defs/vec3"
				},
				"size": {
					"$ref": "#/$defs/vec3"
				}
			}
		},
		"xform": {
			"type": "object",
			"required": [
				"o"
			],
			"description": "origin, and the basis as its rows (omitted = identity)",
			"properties": {
				"o": {
					"$ref": "#/$defs/vec3"
				},
				"b": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 9,
					"maxItems": 9
				}
			}
		},
		"outline": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/vec2"
			}
		},
		"group": {
			"type": "string"
		},
		"mat": {
			"type": "string",
			"description": "a key of the file's materials"
		},
		"shape": {
			"type": "object",
			"required": [
				"shape",
				"args"
			],
			"description": "a PartShapes or FrameParts constructor by name, and its arguments in order",
			"properties": {
				"shape": {
					"enum": [
						"box",
						"wedge",
						"ridge",
						"slope",
						"trapezoid",
						"corner",
						"corner_cut",
						"prism",
						"frustum",
						"girder",
						"i_beam",
						"truss",
						"arc_panel",
						"dome",
						"chamfer_box",
						"ring",
						"nozzle",
						"louvre",
						"inset_panel",
						"porthole_round",
						"porthole_hex",
						"window_rect",
						"window_panel",
						"window_slit",
						"window_tri",
						"canopy_panel",
						"girder_corner",
						"node",
						"plate",
						"square",
						"rect",
						"tri_equilateral",
						"tri_isosceles",
						"tri_right",
						"tri_scalene",
						"plate_trapezoid",
						"parallelogram",
						"rhombus",
						"polygon",
						"chamfered_rect",
						"channel",
						"rib"
					]
				},
				"args": {
					"type": "array"
				}
			}
		},
		"material": {
			"type": "object",
			"anyOf": [
				{
					"required": [
						"livery"
					],
					"properties": {
						"livery": {
							"enum": [
								"shell",
								"trim",
								"dark",
								"soft",
								"top",
								"belly",
								"lining",
								"steel",
								"edge",
								"screen",
								"warm",
								"cold"
							]
						}
					}
				},
				{
					"required": [
						"paint"
					],
					"properties": {
						"paint": {
							"$ref": "#/$defs/color"
						},
						"metallic": {
							"type": "number"
						},
						"roughness": {
							"type": "number"
						},
						"finish": {
							"type": "string"
						}
					}
				},
				{
					"required": [
						"glow",
						"energy"
					],
					"properties": {
						"glow": {
							"$ref": "#/$defs/color"
						},
						"energy": {
							"type": "number",
							"minimum": 0
						}
					}
				},
				{
					"required": [
						"glass"
					],
					"properties": {
						"glass": {
							"type": "string"
						},
						"color": {
							"$ref": "#/$defs/color"
						},
						"metallic": {
							"type": "number"
						},
						"roughness": {
							"type": "number"
						}
					}
				}
			]
		},
		"look": {
			"anyOf": [
				{
					"const": "skip"
				},
				{
					"type": "object",
					"required": [
						"mat"
					],
					"properties": {
						"mat": {
							"$ref": "#/$defs/mat"
						},
						"tag": {
							"type": "string"
						},
						"solid": {
							"type": "boolean"
						}
					}
				}
			]
		},
		"wall": {
			"type": "object",
			"required": [
				"group",
				"mat"
			],
			"anyOf": [
				{
					"required": [
						"wall",
						"at",
						"u",
						"v",
						"thickness",
						"holes"
					]
				},
				{
					"required": [
						"block"
					]
				}
			],
			"properties": {
				"group": {
					"$ref": "#/$defs/group"
				},
				"wall": {
					"enum": [
						"x",
						"y",
						"z"
					]
				},
				"at": {
					"type": "number"
				},
				"u": {
					"$ref": "#/$defs/vec2"
				},
				"v": {
					"$ref": "#/$defs/vec2"
				},
				"thickness": {
					"type": "number",
					"minimum": 0
				},
				"holes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/rect"
					}
				},
				"block": {
					"type": "object",
					"required": [
						"a",
						"b"
					],
					"properties": {
						"a": {
							"$ref": "#/$defs/vec3"
						},
						"b": {
							"$ref": "#/$defs/vec3"
						}
					}
				},
				"mat": {
					"$ref": "#/$defs/mat"
				},
				"tag": {
					"type": "string"
				},
				"box": {
					"$ref": "#/$defs/aabb"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"fitting": {
			"type": "object",
			"required": [
				"group",
				"fitting",
				"args",
				"box"
			],
			"properties": {
				"group": {
					"$ref": "#/$defs/group"
				},
				"fitting": {
					"enum": [
						"seat",
						"console",
						"bunks",
						"locker",
						"galley",
						"table",
						"bench",
						"suit_stand",
						"trophy_shelf",
						"breaker_panel",
						"reactor_cabinet",
						"wall_rack",
						"hold_net",
						"lamp",
						"name_board",
						"armchair",
						"jump_seat",
						"railing",
						"stair_flight",
						"workbench",
						"reactor_core",
						"junction_box",
						"lamp_driver",
						"jump_tank",
						"heat_exchanger"
					]
				},
				"frame": {
					"$ref": "#/$defs/xform"
				},
				"args": {
					"type": "array"
				},
				"box": {
					"$ref": "#/$defs/aabb"
				},
				"label": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"path": {
					"type": "string"
				},
				"ports": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/port"
					}
				},
				"mount": {
					"$ref": "#/$defs/mount"
				}
			}
		},
		"system": {
			"type": "object",
			"required": [
				"group",
				"system",
				"box"
			],
			"properties": {
				"group": {
					"$ref": "#/$defs/group"
				},
				"system": {
					"enum": [
						"control_panel",
						"lift",
						"bowsers",
						"fuel_port",
						"hose_rack",
						"monitor",
						"cockpit_monitor",
						"double_door",
						"door_panel",
						"cockpit_screen",
						"nav_display",
						"map_screen"
					]
				},
				"key": {
					"type": "string"
				},
				"frame": {
					"$ref": "#/$defs/xform"
				},
				"args": {
					"type": "array"
				},
				"box": {
					"$ref": "#/$defs/aabb"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"path": {
					"type": "string"
				},
				"ports": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/port"
					}
				},
				"mount": {
					"$ref": "#/$defs/mount"
				}
			}
		},
		"piece": {
			"type": "object",
			"required": [
				"group",
				"shape",
				"xform"
			],
			"properties": {
				"group": {
					"$ref": "#/$defs/group"
				},
				"shape": {
					"$ref": "#/$defs/shape"
				},
				"xform": {
					"$ref": "#/$defs/xform"
				},
				"mat": {
					"type": [
						"string",
						"null"
					]
				},
				"tag": {
					"type": "string"
				},
				"solid": {
					"type": "boolean"
				},
				"visual": {
					"type": "boolean",
					"description": "false: collision only (a ramp under steps)"
				},
				"glass_mat": {
					"$ref": "#/$defs/mat"
				},
				"part": {
					"type": "object",
					"required": [
						"name",
						"kind",
						"path"
					],
					"properties": {
						"name": {
							"type": "string"
						},
						"kind": {
							"enum": [
								"hull",
								"frame",
								"hazard",
								"conduit",
								"component",
								"glass"
							]
						},
						"path": {
							"$ref": "#/$defs/path"
						},
						"fill": {
							"type": "number"
						}
					},
					"description": "a design's own part (outside every builder and unit)"
				},
				"unit": {
					"type": "string",
					"description": "the unit (units block) whose part this piece folds into"
				}
			}
		},
		"light": {
			"type": "object",
			"required": [
				"group",
				"at",
				"color",
				"energy",
				"range"
			],
			"properties": {
				"group": {
					"$ref": "#/$defs/group"
				},
				"at": {
					"$ref": "#/$defs/vec3"
				},
				"color": {
					"$ref": "#/$defs/color"
				},
				"energy": {
					"type": "number",
					"minimum": 0
				},
				"range": {
					"type": "number",
					"minimum": 0
				},
				"shadows": {
					"type": "boolean"
				}
			}
		},
		"slot": {
			"type": "object",
			"required": [
				"slot_id",
				"display_name",
				"class",
				"accepts",
				"fitted",
				"mount",
				"box",
				"access",
				"group"
			],
			"properties": {
				"slot_id": {
					"type": "string"
				},
				"display_name": {
					"type": "string"
				},
				"class": {
